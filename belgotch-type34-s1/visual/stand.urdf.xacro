<?xml version="1.0"?>
<!-- CC0. 34CSH concept; total support height H-34. No unsupported stand spacing rule. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="belgotch-34csh-stand">
  <xacro:include filename="../../equipment-common/visual/primitives.xacro"/>
  <xacro:arg name="height" default="0.75"/><xacro:arg name="width" default="0.30"/>
  <xacro:arg name="leg" default="0.04"/>
  <xacro:property name="h" value="${$(arg height)-0.034}"/>
  <xacro:property name="w" value="$(arg width)"/><xacro:property name="a" value="$(arg leg)"/>
  <material name="steel"><color rgba="0.61 0.63 0.64 1"/></material>
  <material name="zinc"><color rgba="0.43 0.46 0.49 1"/></material>
  <material name="rubber"><color rgba="0.045 0.047 0.05 1"/></material>
  <link name="root"/>
  <xacro:macro name="leg_pair" params="s suffix">
    <xacro:box name="leg_${suffix}" size="${a} ${a} ${h-0.045}" xyz="0 ${s*(w/2-a/2)} ${(h+0.045)/2}" mat="steel"/>
    <xacro:cylinder name="level_screw_${suffix}" radius="0.008" length="0.045" xyz="0 ${s*(w/2-a/2)} 0.0325" rpy="0 0 0" mat="zinc"/>
    <xacro:cylinder name="foot_${suffix}" radius="${a/2}" length="0.01" xyz="0 ${s*(w/2-a/2)} 0.005" rpy="0 0 0" mat="rubber"/>
    <xacro:box name="top_bracket_${suffix}" size="${a} ${a} 0.02" xyz="0 ${s*(w/2-a/2)} ${h-0.01}" mat="zinc"/>
  </xacro:macro>
  <xacro:leg_pair s="-1" suffix="left"/><xacro:leg_pair s="1" suffix="right"/>
  <xacro:box name="crossbar_lower" size="0.028 ${w-a} 0.028" xyz="0 0 ${h*0.25}" mat="steel"/>
  <xacro:if value="${h &gt;= 0.50}">
    <xacro:box name="crossbar_upper" size="0.028 ${w-a} 0.028" xyz="0 0 ${h*0.70}" mat="steel"/>
  </xacro:if>
</robot>
