<?xml version="1.0"?>
<!--
  SD5-340 screwdriver envelope: the motor body, the nose and the bit on the
  tool's own stroke (CC0-1.0, botrail-assets). Generated by
  tools/generate_urdf.py from bt.tools.screwdriver_urdf — edit the figures
  there, not here.

  Frames (botrail catalog convention, Z-up, metres):
    mount   root = the face that bolts to the hand (ISO 9409-1-50-4-M6), +Z into the tool
    body    the motor housing, a cylinder along the axis
    nose    the front housing the bit runs out of
    bit     the bit, on the prismatic joint `shank` (0 to 55 mm along the axis)
    tip     the bit's free end, turned half a turn about X: +Z back along the tool
-->
<robot name="screwdriver">
  <link name="mount"></link>
  <link name="body"><visual><origin xyz="0 0 0.100000000"/><geometry><cylinder radius="0.043000000" length="0.200000000"/></geometry><material name="body_m"><color rgba="0.0600 0.0600 0.0700 1"/></material></visual><collision><origin xyz="0 0 0.100000000"/><geometry><cylinder radius="0.043000000" length="0.200000000"/></geometry></collision></link>
  <link name="nose"><visual><origin xyz="0 0 0.025000000"/><geometry><cylinder radius="0.015000000" length="0.050000000"/></geometry><material name="nose_m"><color rgba="0.5500 0.5600 0.5800 1"/></material></visual><collision><origin xyz="0 0 0.025000000"/><geometry><cylinder radius="0.015000000" length="0.050000000"/></geometry></collision></link>
  <link name="bit"><visual><origin xyz="0 0 0.031000000"/><geometry><cylinder radius="0.004000000" length="0.060000000"/></geometry><material name="bit_m"><color rgba="0.0600 0.0600 0.0700 1"/></material></visual><collision><origin xyz="0 0 0.031000000"/><geometry><cylinder radius="0.004000000" length="0.060000000"/></geometry></collision></link>
  <link name="tip"></link>
  <joint name="body_joint" type="fixed"><parent link="mount"/><child link="body"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <joint name="nose_joint" type="fixed"><parent link="body"/><child link="nose"/><origin xyz="0.000000000 0.000000000 0.200000000" rpy="0 0 0"/></joint>
  <joint name="shank" type="prismatic"><parent link="nose"/><child link="bit"/><origin xyz="0.000000000 0.000000000 0.050000000"/><axis xyz="0 0 1"/><limit lower="0" upper="0.055000000" effort="50" velocity="0.2"/></joint>
  <joint name="tip_joint" type="fixed"><parent link="bit"/><child link="tip"/><origin xyz="0.000000000 0.000000000 0.061000000" rpy="3.141592653590 0 0"/></joint>
</robot>
