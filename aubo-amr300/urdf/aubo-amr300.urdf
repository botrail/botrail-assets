<joint name="left_wheel_link_joint" type="continuous"><parent link="base_link"/><child link="left_wheel_link"/><origin xyz="0 0.29 0.08" rpy="0 0 0"/><axis xyz="0 1 0"/><limit effort="100" velocity="12"/></joint>
<joint name="right_wheel_link_joint" type="continuous"><parent link="base_link"/><child link="right_wheel_link"/><origin xyz="0 -0.29 0.08" rpy="0 0 0"/><axis xyz="0 1 0"/><limit effort="100" velocity="12"/></joint>
