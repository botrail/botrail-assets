<joint name="fr_caster_wheel_link_joint" type="continuous"><parent link="base_link"/><child link="fr_caster_wheel_link"/><origin xyz="0.38 -0.25 0.05" rpy="0 0 0"/><axis xyz="0 1 0"/><limit effort="100" velocity="12"/></joint>
<joint name="bl_caster_wheel_link_joint" type="continuous"><parent link="base_link"/><child link="bl_caster_wheel_link"/><origin xyz="-0.38 0.25 0.05" rpy="0 0 0"/><axis xyz="0 1 0"/><limit effort="100" velocity="12"/></joint>
