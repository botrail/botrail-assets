<?xml version="1.0"?>
<robot name="aubo_amr300_reference">
<link name="base_footprint"></link>
<link name="base_link"><visual ><geometry ><mesh filename="../meshes/base_link.obj"/></geometry></visual><collision ><origin xyz="0 0 0.12" rpy="0 0 0"/><geometry ><box size="0.94 0.64 0.19"/></geometry></collision><collision ><origin xyz="0 0 0.4075" rpy="0 0 0"/><geometry ><box size="1 0.7 0.385"/></geometry></collision></link>
