<?xml version="1.0"?>
<!--
  Tool Changer A1 — マスタ側 (ロボット側): 空圧ロボットツールチェンジャの自作アセット
  (CC0-1.0)。tool-changer-a1-tool.urdf と対で使う。

  ============================================================================
  参照実機: **SCHUNK SWS-011** (SWK-011-000-000 マスタ + SWA-011-000-000 アダプタ)
    https://schunk.com/us/en/automation-technology/tool-changer/sws/swk-011-000-000/p/000000000000302316
    https://schunk.com/us/en/automation-technology/tool-changer/sws/swa-011-000-000/p/000000000000302317
  ============================================================================

  **これは SWS-011 の複製ではない。** 外観 (ボス径・ポート配置・ボール数・面取り・
  レース形状) はすべて独自著作で、参照実機からは**公表されている数値だけ**を採っている。

  参照実機から採った値 (SCHUNK 公式製品ページの技術データ):
    - 板厚 **マスタ 15.5 mm / アダプタ 20.6 mm** (結合時 36.1 mm)
      → **マスタの方が薄い**のが実機の姿。直感に反するので特記しておく
    - 最大可搬 **16 kg** / ロック力 **1100 N** / 繰返し精度 **0.015 mm**
    - エア通し **6 ポート (6x M5)** / 使用圧 4.5-6.9 bar
    - 許容芯ずれ XY +-1 mm / 角度 +-2 度 (No-Touch 結合の食い付き角の設計根拠)
    - 質量 0.13 kg (マスタ) — 本モデルは後述の外径拡大分だけ割り増し

  参照実機から**意図的に変えた点**:
    - 外径 **ø50 -> ø63**、インタフェースを **ISO 9409-1-50-4-M6** に振り替え。
      SWS-011 は ø50 胴に SCHUNK 独自の "S7" ボルトパターンだが、ø50 の胴には
      ISO 呼び 50 のボルト円 (P.C.D 50) が載らない。**カタログ収録済みの
      UR5e / TM5-900 / 2F-85 / gripper-coupling と直結できること**を優先した。
      ISO 呼び 50 の値 (外径 63 / P.C.D 50 x 4-M6 / 位置決め径 31.5 / ダウエル 6) は
      OMRON i837 (Techman TM5) のフランジ図と一致することを確認済み
    - 質量 0.13 -> **0.15 kg**。外径を広げた分の割り増し (胴の断面積比 (63/50)^2 = 1.59
      をそのまま掛けると 0.21 kg だが、増える分は外周のリング部で中身は変わらないため
      控えめに見積もった)

  なお同クラスの ATI QC-11 も可搬 16 kg / ロック力 1100 N で数値が一致するが、
  **ATI の寸法図は参照していない** — 公開されている Quick-Change マニュアル
  (9610-20-1000) は複製禁止条項付きで、かつ掲載図は中空手首マウント + A15 モジュール版
  (積み高さ 78 mm) と基本形 (52.4 mm) の別構成。SCHUNK を参照実機に選んだのは、
  **公式製品ページに寸法が制限なしで載っている**ため。

  座標系 (botrail カタログ規約): Z-up / メートル。root リンク mount = ロボット
  フランジ接触面 (+Z がツール側)。マスタ側は結合面 `coupling` を上に提示し、
  ツール側プレートがそこへ載る。

  visual: tools/generate_meshes.py が生成する ../meshes/master.stl (手続き的著作)
  collision: URDF プリミティブのみ (板 + カムボス + スピゴット + 側面ポート)。
          ダウエルピンはロボット側フランジの穴に入る消耗形状なので collision に出さない
-->
<robot name="tool_changer_a1_master">

  <link name="mount"/>

  <link name="body">
    <visual>
      <geometry>
        <mesh filename="../meshes/master.stl"/>
      </geometry>
    </visual>

    <collision><!-- main plate, ISO 9409-1 OD ø63 x 15.5 (SWK-011 の板厚) -->
      <origin xyz="0 0 0.00775"/>
      <geometry><cylinder radius="0.0315" length="0.0155"/></geometry>
    </collision>
    <collision><!-- cam boss (enters the tool plate's receiving bore) -->
      <origin xyz="0 0 0.0195"/>
      <geometry><cylinder radius="0.0125" length="0.008"/></geometry>
    </collision>
    <collision><!-- ISO 9409-1 pilot spigot, ø31.5 (seats in the robot flange bore) -->
      <origin xyz="0 0 -0.0025"/>
      <geometry><cylinder radius="0.01575" length="0.005"/></geometry>
    </collision>
    <collision><!-- lock air port boss -->
      <origin xyz="0 0.0325 0.00775" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.004" length="0.008"/></geometry>
    </collision>
    <collision><!-- unlock air port boss -->
      <origin xyz="0 -0.0325 0.00775" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.004" length="0.008"/></geometry>
    </collision>

    <!-- 質量 0.15 kg (SWK-011 の 0.13 kg + 外径拡大分)。慣性は ø63 x 15.5 の中実円柱近似 -->
    <inertial>
      <origin xyz="0 0 0.00775"/>
      <mass value="0.15"/>
      <inertia ixx="4.021e-5" ixy="0.0" ixz="0.0" iyy="4.021e-5" iyz="0.0" izz="7.442e-5"/>
    </inertial>
  </link>

  <!-- 結合面: ツール側プレートの mount がここに載る (積み高さ 36.1 mm の基準) -->
  <link name="coupling"/>

  <joint name="body_joint" type="fixed">
    <parent link="mount"/>
    <child link="body"/>
  </joint>

  <joint name="coupling_joint" type="fixed">
    <origin xyz="0 0 0.0155"/>
    <parent link="body"/>
    <child link="coupling"/>
  </joint>

</robot>
