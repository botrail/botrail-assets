<?xml version="1.0"?>
<!--
  Weld Gun X1: サーボスポットガン (X ガン / シザー式) — botrail-catalog-builder の
  weld-line-requests.md #2 に基づく自作アセット (CC0-1.0)。

  **これは特定メーカー製品の複製ではない。** スポットガンは受注設計のため寸法図を
  公開しているメーカーが無く (OBARA / NIMAK / Milco / ARO / Electroweld を確認)、
  代わりに **公開規格と実機クラスの公表値に寸法を合わせた**独自著作:

  - 電極キャップ = **ISO 5821 Type F, 16 x 20**(規格表: d1=16, l1=20, R1=40,
    テーパ 1:10, Fmax=4 kN)。加圧力 4.0 kN はこの Fmax に一致させてある
  - のど深さ 400 mm = X 型ガンで公開されている標準のど深さ
  - トランスは MFDC 160 kVA / 500 V 1000 Hz 級(OBARA DB3-160 相当の公表値)
  - 質量・重心は FANUC R-2000iC/165F の**手首許容値(J5 940 Nm / 89 kg·m^2、
    J6 490 Nm / 46 kg·m^2、可搬 165 kg)**に収まることを確認済み

  visual: tools/generate_meshes.py が生成する ../meshes/*.stl (手続き的著作、
          寸法定数はスクリプト冒頭の GEOMETRY ブロックに集約)
  collision: URDF プリミティブのみ。**のど (throat) の開口を保つのが目的**で、
          builder はプリミティブを素通しするため VHACD で開口が塞がれない。
          テーパーしたアームは 2 本の円柱で近似し、先端側を細くして開口を稼ぐ。
          可撓物 (ホース・キックレスケーブル) と機体内部のテールには collision 無し

  慣例 (botrail カタログ):
  - Z-up / メートル。root リンク mount = フランジ接触面 (+Z がツール内側)。
    attach_tool はツールを root で溶接する
  - tcp = 固定電極先端 (body 側の固定リンク)
  - electrode_joint は正方向 = 開 (q=0 で電極間 5 mm、q=0.26 rad で先端 112 mm)
-->
<robot name="weld_gun_x1">
  <link name="mount"/>

  <link name="body">
    <visual>
      <geometry><mesh filename="../meshes/body.stl"/></geometry>
    </visual>

    <!-- フランジ板 + 取付ブラケット (溶接構造) -->
    <collision>
      <origin xyz="0.010 0 0.145"/>
      <geometry><box size="0.215 0.195 0.290"/></geometry>
    </collision>
    <!-- MFDC トランス (冷却フィン・端子箱を含む包絡) -->
    <collision>
      <origin xyz="-0.140 0 0.175"/>
      <geometry><box size="0.250 0.320 0.345"/></geometry>
    </collision>
    <!-- サーボ + ボールねじ (可動テールと干渉しないよう前端を -0.02 で止める) -->
    <collision>
      <origin xyz="-0.120 0 0.402"/>
      <geometry><box size="0.200 0.140 0.135"/></geometry>
    </collision>
    <!-- ピボットクレビス -->
    <collision>
      <origin xyz="0.115 0 0.335" rpy="1.5707963268 0 0"/>
      <geometry><cylinder radius="0.038" length="0.160"/></geometry>
    </collision>
    <!-- 固定アーム 根元側 / 先端側 (のど下面。テーパーに合わせて 2 段) -->
    <collision>
      <origin xyz="0.260 0 0.284" rpy="0 1.6072 0"/>
      <geometry><cylinder radius="0.036" length="0.220"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.469 0 0.276" rpy="0 1.6075 0"/>
      <geometry><cylinder radius="0.026" length="0.218"/></geometry>
    </collision>
    <!-- 固定電極 ホルダ + ISO 5821 F16x20 キャップ (上向き、先端 = tcp) -->
    <collision>
      <origin xyz="0.553 0 0.316"/>
      <geometry><cylinder radius="0.020" length="0.048"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.553 0 0.350"/>
      <geometry><cylinder radius="0.009" length="0.020"/></geometry>
    </collision>

    <inertial>
      <!-- 溶接構造 + MFDC トランス + サーボ駆動。慣性は collision プリミティブ群を
           一様密度で質量 78 kg にスケールして算出 -->
      <origin xyz="-0.079 0 0.192"/>
      <mass value="78"/>
      <inertia ixx="1.50" ixy="0" ixz="0" iyy="2.22" iyz="0" izz="1.69"/>
    </inertial>
  </link>

  <link name="electrode_arm">
    <visual>
      <geometry><mesh filename="../meshes/electrode_arm.stl"/></geometry>
    </visual>

    <!-- 可動アーム 根元側 / 先端側。ピボット手前から始めて body クレビスと干渉させない -->
    <collision>
      <origin xyz="0.156 0 0.0735" rpy="0 1.3158 0"/>
      <geometry><cylinder radius="0.032" length="0.194"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.355 0 0.113" rpy="0 1.4240 0"/>
      <geometry><cylinder radius="0.024" length="0.233"/></geometry>
    </collision>
    <!-- 可動電極 ホルダ + ISO 5821 F16x20 キャップ (下向き) -->
    <collision>
      <origin xyz="0.438 0 0.074"/>
      <geometry><cylinder radius="0.020" length="0.048"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.438 0 0.040"/>
      <geometry><cylinder radius="0.009" length="0.020"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0.248 0 0.088"/>
      <mass value="17"/>
      <inertia ixx="0.016" ixy="0" ixz="0" iyy="0.260" iyz="0" izz="0.251"/>
    </inertial>
  </link>

  <link name="tcp"/>

  <joint name="body_joint" type="fixed">
    <parent link="mount"/>
    <child link="body"/>
  </joint>

  <joint name="electrode_joint" type="revolute">
    <origin xyz="0.115 0 0.335"/>
    <parent link="body"/>
    <child link="electrode_arm"/>
    <axis xyz="0 -1 0"/>
    <!-- effort: 電極力 4.0 kN x 電極までの腕 0.438 m = 1.75 kNm。実機はボールねじ
         (テール腕 0.12 m) 経由なのでねじ推力 ~14.6 kN に相当 -->
    <limit lower="0" upper="0.26" effort="1800" velocity="1.2"/>
  </joint>

  <joint name="tcp_joint" type="fixed">
    <origin xyz="0.553 0 0.360"/>
    <parent link="body"/>
    <child link="tcp"/>
  </joint>
</robot>
