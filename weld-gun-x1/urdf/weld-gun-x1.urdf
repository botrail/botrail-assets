<?xml version="1.0"?>
<!--
  Weld Gun X1: サーボスポットガン (X ガン) ドラフト — botrail-catalog-builder の
  weld-line-requests.md #2 に基づく自作アセット (CC0-1.0)。寸法・慣性・電極力は
  プレースホルダで、botrail 側の著作確定版で更新される。

  慣例 (botrail カタログ):
  - Z-up / メートル。root リンク mount = フランジ接触面 (+Z がツール内側へ)。
    attach_tool はツールを root で溶接する
  - tcp = 固定電極先端 (body 側の固定リンク)。frames は recipe の overrides で宣言
  - collision はプリミティブのみで著作し、のど (throat) の開口を保つ
    (builder はプリミティブを素通しするため VHACD で開口が塞がれない)
  - electrode_joint は正方向 = 開 (q=0 閉、電極間 5 mm / q=0.30 rad 先端開き 約95 mm)
-->
<robot name="weld_gun_x1">
  <link name="mount"/>

  <link name="body">
    <!-- ブラケット -->
    <visual>
      <origin xyz="0 0 0.10"/>
      <geometry><box size="0.12 0.14 0.20"/></geometry>
    </visual>
    <!-- サーボハウジング -->
    <visual>
      <origin xyz="-0.10 0 0.28"/>
      <geometry><box size="0.10 0.12 0.18"/></geometry>
    </visual>
    <!-- ヨーク (ピボット支持) -->
    <visual>
      <origin xyz="0.03 0 0.31"/>
      <geometry><box size="0.06 0.10 0.22"/></geometry>
    </visual>
    <!-- 下アーム (固定電極側, のど深さ方向 +X) -->
    <visual>
      <origin xyz="0.20 0 0.24" rpy="0 1.5707963268 0"/>
      <geometry><cylinder radius="0.025" length="0.35"/></geometry>
    </visual>
    <!-- 固定電極ホルダ + チップ -->
    <visual>
      <origin xyz="0.375 0 0.285"/>
      <geometry><cylinder radius="0.02" length="0.09"/></geometry>
    </visual>
    <visual>
      <origin xyz="0.375 0 0.345"/>
      <geometry><cylinder radius="0.008" length="0.03"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.10"/>
      <geometry><box size="0.12 0.14 0.20"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.10 0 0.28"/>
      <geometry><box size="0.10 0.12 0.18"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.03 0 0.31"/>
      <geometry><box size="0.06 0.10 0.22"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.20 0 0.24" rpy="0 1.5707963268 0"/>
      <geometry><cylinder radius="0.025" length="0.35"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.375 0 0.285"/>
      <geometry><cylinder radius="0.02" length="0.09"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.375 0 0.345"/>
      <geometry><cylinder radius="0.008" length="0.03"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.02 0 0.25"/>
      <mass value="28"/>
      <inertia ixx="0.7" ixy="0" ixz="0" iyy="0.8" iyz="0" izz="0.3"/>
    </inertial>
  </link>

  <link name="electrode_arm">
    <!-- 上アーム (可動電極側) -->
    <visual>
      <origin xyz="0.18 0 0.05" rpy="0 1.5707963268 0"/>
      <geometry><cylinder radius="0.025" length="0.36"/></geometry>
    </visual>
    <!-- 可動電極ホルダ + チップ (下向き) -->
    <visual>
      <origin xyz="0.325 0 0.03"/>
      <geometry><cylinder radius="0.02" length="0.10"/></geometry>
    </visual>
    <visual>
      <origin xyz="0.325 0 -0.040"/>
      <geometry><cylinder radius="0.008" length="0.03"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.18 0 0.05" rpy="0 1.5707963268 0"/>
      <geometry><cylinder radius="0.025" length="0.36"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.325 0 0.03"/>
      <geometry><cylinder radius="0.02" length="0.10"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.325 0 -0.040"/>
      <geometry><cylinder radius="0.008" length="0.03"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.20 0 0.03"/>
      <mass value="7"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.10" iyz="0" izz="0.10"/>
    </inertial>
  </link>

  <link name="tcp"/>

  <joint name="body_joint" type="fixed">
    <parent link="mount"/>
    <child link="body"/>
  </joint>

  <joint name="electrode_joint" type="revolute">
    <origin xyz="0.05 0 0.42"/>
    <parent link="body"/>
    <child link="electrode_arm"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.30" effort="200" velocity="2.0"/>
  </joint>

  <joint name="tcp_joint" type="fixed">
    <origin xyz="0.375 0 0.36"/>
    <parent link="body"/>
    <child link="tcp"/>
  </joint>
</robot>
