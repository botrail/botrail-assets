<?xml version="1.0"?>
<!--
  Weld Gun X1: サーボスポットガン (X ガン / シザー式) — botrail-catalog-builder の
  weld-line-requests.md #2 に基づく自作アセット (CC0-1.0)。

  visual: tools/generate_meshes.py が生成する ../meshes/*.stl (手続き的著作、
          寸法定数はスクリプト冒頭の GEOMETRY ブロックに集約)
  collision: URDF プリミティブのみ。**のど (throat) の開口を保つのが目的**で、
          builder はプリミティブを素通しするため VHACD で開口が塞がれない。
          visual メッシュを包む粗い包絡として著作してあり、可撓物 (ホース・
          キックレスケーブル) と機体内部のテールには collision を与えない

  慣例 (botrail カタログ):
  - Z-up / メートル。root リンク mount = フランジ接触面 (+Z がツール内側)。
    attach_tool はツールを root で溶接する
  - tcp = 固定電極先端 (body 側の固定リンク)
  - electrode_joint は正方向 = 開 (q=0 で電極間 5 mm、q=0.42 rad で先端 108 mm)

  実測値 (tools/ で計測。README のプロファイル表を参照):
    のど深さ 220 mm / のど開口 102 mm (電極位置, q=0) 〜 41 mm (のど奥)
    電極先端ストローク 103 mm / 質量 85 kg
-->
<robot name="weld_gun_x1">
  <link name="mount"/>

  <link name="body">
    <visual>
      <geometry><mesh filename="../meshes/body.stl"/></geometry>
    </visual>

    <!-- フランジ板 + 取付ブラケット (溶接構造) -->
    <collision>
      <origin xyz="0.010 0 0.145"/>
      <geometry><box size="0.215 0.195 0.290"/></geometry>
    </collision>
    <!-- MFDC トランス (冷却フィン・端子箱を含む包絡) -->
    <collision>
      <origin xyz="-0.140 0 0.175"/>
      <geometry><box size="0.250 0.320 0.345"/></geometry>
    </collision>
    <!-- サーボ + ボールねじ (可動テールと干渉しないよう前端を -0.02 で止める) -->
    <collision>
      <origin xyz="-0.120 0 0.402"/>
      <geometry><box size="0.200 0.140 0.135"/></geometry>
    </collision>
    <!-- ピボットクレビス -->
    <collision>
      <origin xyz="0.115 0 0.335" rpy="1.5707963268 0 0"/>
      <geometry><cylinder radius="0.038" length="0.160"/></geometry>
    </collision>
    <!-- 固定アーム (のど下面。電極軸まで伸ばし、のど開口はここから上に開く) -->
    <collision>
      <origin xyz="0.274 0 0.2865" rpy="0 1.5990 0"/>
      <geometry><cylinder radius="0.032" length="0.248"/></geometry>
    </collision>
    <!-- 固定電極 ホルダ + キャップ (上向き、先端 = tcp) -->
    <collision>
      <origin xyz="0.375 0 0.315"/>
      <geometry><cylinder radius="0.021" length="0.042"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.375 0 0.348"/>
      <geometry><cylinder radius="0.011" length="0.024"/></geometry>
    </collision>

    <inertial>
      <origin xyz="-0.050 0 0.220"/>
      <mass value="72"/>
      <inertia ixx="1.76" ixy="0" ixz="0" iyy="2.72" iyz="0" izz="2.04"/>
    </inertial>
  </link>

  <link name="electrode_arm">
    <visual>
      <geometry><mesh filename="../meshes/electrode_arm.stl"/></geometry>
    </visual>

    <!-- 可動アーム (のど上面)。ピボット手前から始めて body のクレビスと干渉させない -->
    <collision>
      <origin xyz="0.172 0 0.081" rpy="0 1.2972 0"/>
      <geometry><cylinder radius="0.030" length="0.242"/></geometry>
    </collision>
    <!-- 可動電極 ホルダ + キャップ (下向き) -->
    <collision>
      <origin xyz="0.260 0 0.074"/>
      <geometry><cylinder radius="0.021" length="0.040"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.260 0 0.042"/>
      <geometry><cylinder radius="0.011" length="0.024"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0.130 0 0.050"/>
      <mass value="13"/>
      <inertia ixx="0.054" ixy="0" ixz="0" iyy="0.210" iyz="0" izz="0.199"/>
    </inertial>
  </link>

  <link name="tcp"/>

  <joint name="body_joint" type="fixed">
    <parent link="mount"/>
    <child link="body"/>
  </joint>

  <joint name="electrode_joint" type="revolute">
    <origin xyz="0.115 0 0.335"/>
    <parent link="body"/>
    <child link="electrode_arm"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.42" effort="2400" velocity="1.2"/>
  </joint>

  <joint name="tcp_joint" type="fixed">
    <origin xyz="0.375 0 0.360"/>
    <parent link="body"/>
    <child link="tcp"/>
  </joint>
</robot>
