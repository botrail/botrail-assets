<?xml version="1.0"?>
<!--
  Weld Gun C1: 小型サーボスポットガン (C ガン / 直動式) — botrail-catalog-builder の
  weld-line-requests.md #2「C ガン (prismatic) は次」に対応する自作アセット (CC0-1.0)。

  **これは特定メーカー製品の複製ではない。** 寸法図を公開しているメーカーは無いため
  (weld-gun-x16005 で OBARA / NIMAK / Milco / ARO / Electroweld を確認済み)、
  **外観は独自著作のまま、寸法と仕様だけを実機の公表値に一致させてある**:

  - **のど 230 x 225 mm / トランス 100 kVA / 質量 84 kg** = Milco XR モジュラー
    C ガン **637-12402-15** の公表値 (ERS Engineering 掲載の Milco 資料)。
    同ライブラリの他の C ガンは 180x345 (80 kg) と 230x315 (90 kg) なので、
    225 mm は Milco C ガン系で最も浅いのど深さにあたる
  - 電極キャップ = **ISO 5821 Type F, 16 x 20** (d1=16, l1=20, R1=40, テーパ 1:10,
    Fmax=4 kN)。加圧力 4.0 kN はこの Fmax に一致させてある。
    Milco の枠強度は 1100 lbf = 4.9 kN なので、**制限しているのはキャップ側**
  - ストローク 80 mm = HERON DB6-110-C16027 (C 型サーボガン) の 78 mm 相当。
    TECNA の C ガン 3020/3024 の max stroke 75-100 mm とも整合
  - 質量・重心は FANUC R-2000iC/165F の手首許容値に収まることを確認済み
    (84 kg / J5 180 Nm・11.0 kg·m^2 / J6 23 Nm・5.6 kg·m^2 に対し、
     許容 165 kg / 940 Nm・89 kg·m^2 / 490 Nm・46 kg·m^2)。
    **トランスはマウント後方に置いてある** — 喉と同じ高さに座らせると打点まわりで
    真っ先に当たるのがトランスになるうえ、重心がツール軸から外れて J6 が重くなる

  weld-gun-x16005 との使い分け: X 側はのど 384 mm でフランジの奥まで届くが手首が
  打点から遠くなる。本機はのど 225 mm で TCP が mount から 0.468 m (X 側は 0.647 m)
  なので、**手首を打点に寄せられる代わりに深いところへは入らない**。

  visual: tools/generate_meshes.py が生成する ../meshes/*.stl (手続き的著作)
  collision: URDF プリミティブのみ。**のど (throat) の開口を保つのが目的**で、
          builder はプリミティブを素通しするため VHACD で開口が塞がれない。
          アクチュエータは中央にラムの通るボアがあるので左右 2 枚 + 上蓋で表し、
          ラムの掃引域は electrode_ram 側の collision が受け持つ (二重計上しない)。
          可撓物 (キックレスケーブル・水配管) には collision 無し

  慣例 (botrail カタログ):
  - Z-up / メートル。root リンク mount = フランジ接触面 (+Z がツール内側)。
    attach_tool はツールを root で溶接する
  - tcp = 固定電極先端 (body 側の固定リンク)
  - electrode_joint は prismatic で **正方向 = 開** (q=0 で電極間 5 mm、
    q=0.080 m で電極間 85 mm)。x1 の revolute と符号の意味を揃えてある
-->
<robot name="weld_gun_xr637">

  <link name="mount"/>

  <link name="body">
    <visual>
      <geometry>
        <mesh filename="../meshes/body.stl"/>
      </geometry>
    </visual>

    <collision><!-- mount flange -->
      <origin xyz="0 0 0.008"/>
      <geometry><cylinder radius="0.08" length="0.016"/></geometry>
    </collision>
    <collision><!-- MFDC transformer (behind the mount, clear of the throat plane) -->
      <origin xyz="-0.17 0 0.16"/>
      <geometry><box size="0.26 0.29 0.28"/></geometry>
    </collision>
    <collision><!-- spine, mount to C-frame column -->
      <origin xyz="0.04 0 0.155"/>
      <geometry><box size="0.2 0.156 0.19"/></geometry>
    </collision>
    <collision><!-- C-frame column -->
      <origin xyz="0.165 0 0.295"/>
      <geometry><box size="0.07 0.116 0.47"/></geometry>
    </collision>
    <collision><!-- lower arm -->
      <origin xyz="0.3075 0 0.1"/>
      <geometry><box size="0.325 0.09 0.05"/></geometry>
    </collision>
    <collision><!-- upper beam -->
      <origin xyz="0.3425 0 0.5"/>
      <geometry><box size="0.285 0.104 0.06"/></geometry>
    </collision>
    <collision><!-- actuator housing +y (bore left clear for the ram and its receiver) -->
      <origin xyz="0.425 0.053 0.4125"/>
      <geometry><box size="0.12 0.034 0.115"/></geometry>
    </collision>
    <collision><!-- actuator housing -y -->
      <origin xyz="0.425 -0.053 0.4125"/>
      <geometry><box size="0.12 0.034 0.115"/></geometry>
    </collision>
    <collision><!-- actuator housing top (above the ram's full-open position) -->
      <origin xyz="0.425 0 0.455"/>
      <geometry><box size="0.12 0.14 0.03"/></geometry>
    </collision>
    <collision><!-- servo motor -->
      <origin xyz="0.425 0 0.581"/>
      <geometry><cylinder radius="0.055" length="0.102"/></geometry>
    </collision>
    <collision><!-- fixed electrode holder -->
      <origin xyz="0.425 0 0.15"/>
      <geometry><cylinder radius="0.02" length="0.05"/></geometry>
    </collision>
    <collision><!-- fixed cap, ISO 5821 Type F 16x20 -->
      <origin xyz="0.425 0 0.185"/>
      <geometry><cylinder radius="0.009" length="0.02"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0.00816 0 0.21351"/>
      <mass value="80.0"/>
      <inertia ixx="2.18575" ixy="0.0" ixz="-1.57456" iyy="6.30116" iyz="0.0" izz="4.84279"/>
    </inertial>
  </link>

  <link name="electrode_ram">
    <visual>
      <geometry>
        <mesh filename="../meshes/electrode_ram.stl"/>
      </geometry>
    </visual>

    <collision><!-- ram (ball screw) -->
      <origin xyz="0 0 -0.0425"/>
      <geometry><cylinder radius="0.026" length="0.085"/></geometry>
    </collision>
    <collision><!-- holder receiver -->
      <origin xyz="0 0 -0.087"/>
      <geometry><cylinder radius="0.032" length="0.024"/></geometry>
    </collision>
    <collision><!-- moving electrode holder -->
      <origin xyz="0 0 -0.11"/>
      <geometry><cylinder radius="0.02" length="0.05"/></geometry>
    </collision>
    <collision><!-- moving cap, ISO 5821 Type F 16x20 -->
      <origin xyz="0 0 -0.145"/>
      <geometry><cylinder radius="0.009" length="0.02"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 -0.07997"/>
      <mass value="4.0"/>
      <inertia ixx="0.00751" ixy="0.0" ixz="0.0" iyy="0.00751" iyz="0.0" izz="0.00119"/>
    </inertial>
  </link>

  <link name="tcp"/>

  <joint name="body_joint" type="fixed">
    <parent link="mount"/>
    <child link="body"/>
  </joint>

  <joint name="electrode_joint" type="prismatic">
    <origin xyz="0.425 0 0.355"/>
    <parent link="body"/>
    <child link="electrode_ram"/>
    <axis xyz="0 0 1"/>
    <!-- effort = 加圧力 4.0 kN (ISO 5821 ⌀16 の Fmax)、velocity = 0.25 m/s -->
    <limit lower="0" upper="0.080" effort="4000" velocity="0.25"/>
  </joint>

  <joint name="tcp_joint" type="fixed">
    <origin xyz="0.425 0 0.195"/>
    <parent link="body"/>
    <child link="tcp"/>
  </joint>

</robot>
