<?xml version="1.0"?>
<!--
  Vacuum Gripper V1: コボット向け電動真空グリッパの自作アセット (CC0-1.0)。
  カタログに gripper.vacuum のモデルが 1 つも無かったのを埋めるために著作した。

  ============================================================================
  参照実機: **Schmalz CobotPump ECBPi** (電動真空発生器 ECBPi 12 24V-DC M12-8)
    製品ページ (技術データ):
    https://www.schmalz.com/en/products/vacuum-technology-for-automation-301607/vacuum-components-301608/vacuum-generators-307617/electric-vacuum-generators-738973/electric-vacuum-generators-end-of-arm-739374/vacuum-generators-ecbpi-308294/10.03.01.00314
  ============================================================================

  **これは ECBPi の複製ではない。** 外観 (面取り・パネル位置・バヨネット爪・カップ形状)
  はすべて独自著作で、参照実機からは**公表されている数値だけ**を採っている。

  参照実機から採った値 (公式製品ページ / 取扱説明書 4.4-4.5 の公表値):
    - 外形 **D = ø151.5 mm** — **丸みを帯びた三角断面**が実機の姿。円筒ではない
    - 上部ボス **D2 = ø76 mm** / 全高 **L = 88.6 mm**
    - 質量 **0.75 kg** (本体のみ)
    - 負荷限界 **水平取付 max 100 N / 垂直取付 max 25 N (レバー長 100 mm)**
    - 最大真空 **75%** / 吸込量 **0-12 L/min** / 騒音 57 dBA
    - 吸着エンドエフェクタは**バヨネットで工具レス差し替え**という構成

  取付インタフェースも**実機どおり**: **3 x M4 / ボルト円 ø46 (Dmk1) / ねじ深さ 6**。
  ISO 9409-1 ではないので**ロボットフランジには直付けできない** — 実機と同じく
  フランジプレートを介する (カタログでは別アセット flange-plate-ecbpi が担当)。
  「利用者が持っている実機でそのままシミュレーションできるか」を優先し、
  組み合わせの都合でインタフェースを描き替えることはしない。

  参照実機から**意図的に変えた点**:
    - 吸着プレート + ベローズカップ ø40 x 4 は**当方の設計** (参照実機ではバヨネットに
      付く別売エンドエフェクタで、2 カップ / 4 カップ・ベローズ / フラットの選択制)。
      質量 0.75 -> **1.0 kg** の差分はこのプレートとカップ分
    - 可搬は参照実機の**水平 100 N (約 10 kg)** をそのまま定格として採る。カップ 4 個の
      理論吸着力 (ø40, 75% 真空で 1 個あたり約 94 N) はこれを上回るので、
      **律速するのはポンプ/取付側**

  座標系 (botrail カタログ規約): Z-up / メートル。root リンク mount = 取付面
  (フランジプレートが当たる面。+Z がツール側)。tcp = カップ接触面 (mount から 118 mm)。

  visual: tools/generate_meshes.py が生成する ../meshes/{body,cups}.stl (手続き的著作)
  collision: URDF プリミティブのみ。三角断面の胴は**中央 1 本 + ローブ 3 本の円柱**で
          近似してある (外接円 1 本で包むと 3 面の平らな部分が 28 mm も太る)。
          表示パネルは胴から約 10 mm 出るので別途 box で持たせている
-->
<robot name="vacuum_gripper_ecbpi">

  <link name="mount"/>

  <link name="body">
    <visual>
      <geometry>
        <mesh filename="../meshes/body.stl"/>
      </geometry>
    </visual>
    <visual>
      <geometry>
        <mesh filename="../meshes/cups.stl"/>
      </geometry>
    </visual>

    <collision><!-- upper boss, ECBPi D2 = ø76 -->
      <origin xyz="0 0 0.005"/>
      <geometry><cylinder radius="0.038" length="0.010"/></geometry>
    </collision>
    <collision><!-- tri-lobe body: central core (inscribed radius) -->
      <origin xyz="0 0 0.043"/>
      <geometry><cylinder radius="0.0478" length="0.066"/></geometry>
    </collision>
    <collision><!-- tri-lobe body: lobe at 0 deg -->
      <origin xyz="0.04775 0 0.043"/>
      <geometry><cylinder radius="0.028" length="0.066"/></geometry>
    </collision>
    <collision><!-- tri-lobe body: lobe at 120 deg -->
      <origin xyz="-0.023875 0.041353 0.043"/>
      <geometry><cylinder radius="0.028" length="0.066"/></geometry>
    </collision>
    <collision><!-- tri-lobe body: lobe at 240 deg -->
      <origin xyz="-0.023875 -0.041353 0.043"/>
      <geometry><cylinder radius="0.028" length="0.066"/></geometry>
    </collision>
    <collision><!-- display panel (protrudes ~10 mm past the body) -->
      <origin xyz="0 -0.06775 0.043"/>
      <geometry><box size="0.046 0.008 0.030"/></geometry>
    </collision>
    <collision><!-- bayonet ring (tool-less suction plate change) -->
      <origin xyz="0 0 0.0823"/>
      <geometry><cylinder radius="0.042" length="0.0126"/></geometry>
    </collision>
    <collision><!-- suction plate -->
      <origin xyz="0 0 0.0923"/>
      <geometry><cylinder radius="0.055" length="0.0074"/></geometry>
    </collision>
    <collision><!-- bellows cup 1 -->
      <origin xyz="0.023335 0.023335 0.107"/>
      <geometry><cylinder radius="0.020" length="0.022"/></geometry>
    </collision>
    <collision><!-- bellows cup 2 -->
      <origin xyz="-0.023335 0.023335 0.107"/>
      <geometry><cylinder radius="0.020" length="0.022"/></geometry>
    </collision>
    <collision><!-- bellows cup 3 -->
      <origin xyz="-0.023335 -0.023335 0.107"/>
      <geometry><cylinder radius="0.020" length="0.022"/></geometry>
    </collision>
    <collision><!-- bellows cup 4 -->
      <origin xyz="0.023335 -0.023335 0.107"/>
      <geometry><cylinder radius="0.020" length="0.022"/></geometry>
    </collision>

    <!-- 質量 1.0 kg = ECBPi 本体 0.75 kg + 吸着プレート/カップ 0.25 kg (当方の追加分)。
         慣性は実効 ø110 x 120 の中実円柱近似 -->
    <inertial>
      <origin xyz="0 0 0.048"/>
      <mass value="1.0"/>
      <inertia ixx="1.96e-3" ixy="0.0" ixz="0.0" iyy="1.96e-3" iyz="0.0" izz="1.51e-3"/>
    </inertial>
  </link>

  <!-- 吸着面 (カップ接触面)。ワークはここに吸い付く -->
  <link name="tcp"/>

  <joint name="body_joint" type="fixed">
    <parent link="mount"/>
    <child link="body"/>
  </joint>

  <joint name="tcp_joint" type="fixed">
    <origin xyz="0 0 0.118"/>
    <parent link="body"/>
    <child link="tcp"/>
  </joint>

</robot>
