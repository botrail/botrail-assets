<?xml version="1.0"?>
<robot name="robotiq_hand_e_hnd_grp">
<link name="mount"><visual ><geometry ><mesh filename="../meshes/mount.obj"/></geometry></visual><collision ><origin xyz="0 0 0.012" rpy="0 0 0"/><geometry ><cylinder radius="0.0375" length="0.024"/></geometry></collision><collision ><origin xyz="0 0 0.048" rpy="0 0 0"/><geometry ><cylinder radius="0.027" length="0.048"/></geometry></collision><collision ><origin xyz="0 0 0.08625" rpy="0 0 0"/><geometry ><cylinder radius="0.0375" length="0.0285"/></geometry></collision></link>
<link name="left_finger"><visual ><geometry ><mesh filename="../meshes/left_finger.obj"/></geometry></visual><collision ><origin xyz="0.009 0 0.1005" rpy="0 0 0"/><geometry ><box size="0.015 0.027 0.01"/></geometry></collision><collision ><origin xyz="0.01 0 0.111" rpy="0 0 0"/><geometry ><box size="0.01 0.024 0.016"/></geometry></collision><collision ><origin xyz="0.0041 0 0.1325" rpy="0 0 0"/><geometry ><box size="0.0082 0.024 0.027"/></geometry></collision></link>
<link name="left_contact"></link>
<link name="right_finger"><visual ><geometry ><mesh filename="../meshes/right_finger.obj"/></geometry></visual><collision ><origin xyz="-0.009 0 0.1005" rpy="0 0 0"/><geometry ><box size="0.015 0.027 0.01"/></geometry></collision><collision ><origin xyz="-0.01 0 0.111" rpy="0 0 0"/><geometry ><box size="0.01 0.024 0.016"/></geometry></collision><collision ><origin xyz="-0.0041 0 0.1325" rpy="0 0 0"/><geometry ><box size="0.0082 0.024 0.027"/></geometry></collision></link>
<link name="right_contact"></link>
<link name="tcp"></link>
<joint name="finger_joint" type="prismatic"><parent link="mount"/><child link="left_finger"/><origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/><limit lower="0" upper="0.025" velocity="0.05" effort="50"/></joint>
<joint name="left_contact_joint" type="fixed"><parent link="left_finger"/><child link="left_contact"/><origin xyz="0 0 0.1335" rpy="0 0 0"/></joint>
<joint name="finger_mirror_joint" type="prismatic"><parent link="mount"/><child link="right_finger"/><origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="-1 0 0"/><limit lower="0" upper="0.025" velocity="0.05" effort="50"/><mimic joint="finger_joint" multiplier="1" offset="0"/></joint>
